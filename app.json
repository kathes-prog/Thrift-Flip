{
  "expo": {
    "name": "Thrift Flip Studio",
    "slug": "thrift-flip-studio",
    "scheme": "thriftflip",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "edu.cis4120.thriftflipstudio"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F7F3EC"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Thrift Flip Studio uses your photos of garments and fabric scraps to plan upcycling projects.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ]
  }
}
